# Configurações do Remetente

NOME_REMETENTE="Grow"
EMAIL_REMETENTE="teste@grownt.tech"
ASSUNTO_EMAIL="Boas vindas à plataforma!"

# Configurações do Template de Email

ID_TEMPLATE=1
TIPO_EMAIL=1

# Destinatários em Cópia (CC) - separados por vírgula
# IMPORTANTE: A quantidade de e-mails deve ser a mesma da quantidade de nomes.

EMAILS_EM_COPIA="ricardo.oliveira@dgtallab.com.br,outro.email@exemplo.com"
NOMES_EM_COPIA="Ricardo Oliveira,Outro Nome"'

# Destinatários em Cópia Oculta (BCC) - separados por vírgula
# IMPORTANTE: A quantidade de e-mails deve ser a mesma da quantidade de nomes.

EMAILS_COPIA_OCULTA="ricardo.oliveira@dgtallab.com.br"
NOMES_COPIA_OCULTA="Ricardo Oliveira"

# ======================================================
# NOVAS VARIÁVEIS - Configurações da API de Envio
# ======================================================

API_URL="http://localhost:8086/api/v1/emails"
AUTH_TOKEN="coloque_seu_token_jwt_aqui"